<script>
(function(){
const d=document,$=(s,e)=>(e||d).querySelector(s),$$=(s,e)=>[...(e||d).querySelectorAll(s)];
const NUM='5518997707955',fine=matchMedia('(hover:hover) and (pointer:fine)').matches,rm=matchMedia('(prefers-reduced-motion:reduce)').matches;
$$('[data-wa]').forEach(a=>{const m=a.dataset.m||(a.dataset.s?'Olá! Gostaria de agendar um horário na Panda Barbearia para: '+a.dataset.s+'.':'Olá! Gostaria de agendar um horário na Panda Barbearia.');a.href='https://wa.me/'+NUM+'?text='+encodeURIComponent(m);a.target='_blank';a.rel='noopener';if(a.classList.contains('btn')&&!a.dataset.s&&!a.dataset.m)a.dataset.cur='AGENDAR';a.addEventListener('click',()=>{a.classList.add('ck');setTimeout(()=>a.classList.remove('ck'),450)})});
$('#yr').textContent=new Date().getFullYear();
$$('[data-w]').forEach(h=>{h.setAttribute('aria-label',h.innerHTML.replace(/<br\s*\/?>/g,' ').replace(/<[^>]+>/g,''));let k=0;[...h.childNodes].forEach(c=>{if(c.nodeType!==3)return;const f=d.createDocumentFragment();c.textContent.split(/(\s+)/).forEach(t=>{if(!t)return;if(/^\s+$/.test(t)){f.appendChild(d.createTextNode(' '));return}const o=d.createElement('i'),i=d.createElement('i');o.className='wo';o.setAttribute('aria-hidden','true');i.className='wi';i.textContent=t;i.style.setProperty('--k',k++);o.appendChild(i);f.appendChild(o)});c.replaceWith(f)})});
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.12});$$('.rvl,[data-w]').forEach(e=>io.observe(e));const mio=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');mio.unobserve(e.target)}}),{threshold:0,rootMargin:'0px 0px -12% 0px'});$$('.mk').forEach(e=>mio.observe(e));const mpp=$('.mp');mpp.onclick=()=>mpp.classList.add('act');mpp.onmouseleave=()=>mpp.classList.remove('act');
const cio=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;cio.unobserve(e.target);if(rm)return;const el=e.target,T=+el.dataset.c,dg=+el.dataset.d||0,t0=performance.now();(function f(t){const p=Math.min((t-t0)/1300,1),v=T*(1-Math.pow(1-p,3));el.textContent=v.toFixed(dg).replace('.',',');if(p<1)requestAnimationFrame(f)})(t0)}));$$('[data-c]').forEach(e=>cio.observe(e));
// menu
const bg=$('#bg'),nv=$('#nv');$$('li',nv).forEach((l,i)=>l.style.setProperty('--i',i));
const menu=o=>{nv.classList.toggle('on',o);bg.setAttribute('aria-expanded',o);bg.setAttribute('aria-label',o?'Fechar menu':'Abrir menu');d.body.style.overflow=o?'hidden':''};
bg.onclick=()=>menu(!nv.classList.contains('on'));$$('a',nv).forEach(a=>a.onclick=()=>menu(false));
