if(!rm){mq.style.transform='translate3d('+(-(H-mq.parentNode.getBoundingClientRect().top)*.3).toFixed(1)+'px,0,0)';sp.forEach(e=>{const p=e.parentNode.getBoundingClientRect();if(p.bottom>-300&&p.top<H+300)e.style.transform='translate3d(0,'+((p.top+p.height/2-H/2)*-(+e.dataset.sp)).toFixed(1)+'px,0)'})}tk2=false}
addEventListener('scroll',()=>{if(!tk2){tk2=true;requestAnimationFrame(onS)}},{passive:true});onS();up.onclick=()=>scrollTo({top:0,behavior:'smooth'});
// lightbox
let set=[],cur=0,last;const lb=$('#lb'),li=$('#li'),cnt=$('#cnt');
