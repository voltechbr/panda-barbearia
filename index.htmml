<div class="gal rvl" id="gal">
<button class="gi g1" data-cur="VIEW"><img loading="lazy" src="data:image/webp;base64," alt="Corte social com degradê e topo alto, visto de lado"></button>
<button class="gi g2" data-cur="VIEW"><img loading="lazy" src="data:image/webp;base64," alt="Corte com desenho feito na máquina na lateral da cabeça"></button>
<button class="gi g3" data-cur="VIEW"><img loading="lazy" src="data:image/webp;base64," alt="Corte com topo alto e risco desenhado na lateral"></button>
<div class="gt"><h3>Seu corte é o próximo.</h3><a class="btn" href="#" data-wa>Agendar horário</a></div>
</div></div></section>

<section id="servicos" style="padding-top:0"><div class="w"><div class="svh"><div><h2 data-w>Serviços.</h2><p class="rvl">Cortes masculinos, barba e acabamentos, com atendimento profissional.</p></div><div class="fi mk" id="fi" data-cur="VIEW"><img data-sp=".06" loading="lazy" id="fimg" src="data:image/webp;base64," alt="Corte degradê com topo penteado para trás feito na Panda Barbearia"></div></div>
