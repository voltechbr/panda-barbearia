const open=(l,i)=>{set=l;last=d.activeElement;$('.p',lb).style.display=$('.n',lb).style.display=l.length>1?'':'none';show(i);lb.classList.add('on');d.body.style.overflow='hidden';$('.x',lb).focus()};
const close=()=>{lb.classList.remove('on');d.body.style.overflow='';last&&last.focus()};
const gimgs=$$('#gal img').map(i=>({s:i.src,a:i.alt}));$$('.gi').forEach((b,i)=>b.onclick=()=>open(gimgs,i));
$('#fi').onclick=()=>open([{s:$('#fimg').src,a:$('#fimg').alt}],0);$('#pim').onclick=()=>open([{s:$('#pimg').src,a:$('#pimg').alt}],0);
$('.x',lb).onclick=close;$('.p',lb).onclick=()=>show(cur-1);$('.n',lb).onclick=()=>show(cur+1);lb.onclick=e=>{if(e.target===lb)close()};
addEventListener('keydown',e=>{if(!lb.classList.contains('on'))return;if(e.key==='Escape')close();if(e.key==='ArrowLeft')show(cur-1);if(e.key==='ArrowRight')show(cur+1)});
let tx0=null;lb.addEventListener('touchstart',e=>{tx0=e.touches[0].clientX},{passive:true});lb.addEventListener('touchend',e=>{if(tx0===null||set.length<2)return;const x=e.changedTouches[0].clientX-tx0;if(Math.abs(x)>50)show(cur+(x<0?1:-1));tx0=null});
// carousel
const tk=$('#tk'),n=tk.children.length,dots=$('#dots'),cr=$('#cr');let ci=0,timer,paused=false;
for(let k=0;k<n;k++){const b=d.createElement('button');b.setAttribute('aria-label','Avaliação '+(k+1));b.onclick=()=>{go(k);auto()};dots.appendChild(b)}
function go(i){ci=(i+n)%n;tk.style.transform='translateX('+(-100*ci)+'%)';$$('button',dots).forEach((b,j)=>b.setAttribute('aria-current',j===ci))}
function auto(){clearInterval(timer);timer=setInterval(()=>{if(!paused)go(ci+1)},5500)}
$('#pv').onclick=()=>{go(ci-1);auto()};$('#nx').onclick=()=>{go(ci+1);auto()};cr.onmouseenter=()=>paused=true;cr.onmouseleave=()=>paused=false;
let sx=0;cr.addEventListener('touchstart',e=>{sx=e.touches[0].clientX;paused=true},{passive:true});cr.addEventListener('touchend',e=>{const x=e.changedTouches[0].clientX-sx;if(Math.abs(x)>40)go(ci+(x<0?1:-1));paused=false;auto()});go(0);auto();
// cursor + hero depth (desktop com mouse)
if(fine&&!rm){
d.documentElement.classList.add('cur');
const E=c=>{const e=d.createElement('div');e.className=c;d.body.appendChild(e);return e},dot=E('cdot'),ring=E('cring'),lab=d.createElement('span');ring.appendChild(lab);
const TR=[];for(let i=0;i<6;i++)TR.push({e:E('ctrl'),x:-99,y:-99});
const mags=$$('.mag'),hw=$('#hw');let mx=-99,my=-99,rx=-99,ry=-99,nx=0,ny=0,hx=0,hy=0,run=false,st='';
function loop(){rx+=(mx-rx)*.17;ry+=(my-ry)*.17;ring.style.transform='translate3d('+rx+'px,'+ry+'px,0) translate(-50%,-50%)';
const mv=Math.abs(mx-rx)+Math.abs(my-ry)>2;let px=mx,py=my;
TR.forEach((t,i)=>{const f=.3-i*.04;t.x+=(px-t.x)*f;t.y+=(py-t.y)*f;t.e.style.transform='translate3d('+t.x+'px,'+t.y+'px,0) translate(-50%,-50%) scale('+(1-i*.13)+')';t.e.style.opacity=mv?(.4-i*.06):0;px=t.x;py=t.y});
const tx=nx*-16,ty=ny*-10;hx+=(tx-hx)*.06;hy+=(ty-hy)*.06;him.style.setProperty('--mx',hx.toFixed(2));him.style.setProperty('--my',hy.toFixed(2));hw.style.transform='translate3d('+(-hx*.8).toFixed(2)+'px,'+(-hy*.8).toFixed(2)+'px,0)';
if(mv||Math.abs(tx-hx)>.05||Math.abs(ty-hy)>.05)requestAnimationFrame(loop);else run=false}
addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;nx=mx/innerWidth-.5;ny=my/innerHeight-.5;dot.style.transform='translate3d('+mx+'px,'+my+'px,0) translate(-50%,-50%)';ring.style.opacity=1;if(!run){run=true;requestAnimationFrame(loop)}
const t=e.target.closest?e.target.closest('[data-cur],a,button'):null,tx=t&&t.dataset.cur||'',k=t?(tx?'lab':'hov'):'';if(k+tx!==st){st=k+tx;ring.className='cring '+k;lab.textContent=tx}
mags.forEach(b=>{const r=b.getBoundingClientRect(),dx=e.clientX-r.left-r.width/2,dy=e.clientY-r.top-r.height/2;b.style.transform=Math.hypot(dx,dy)<r.width/2+70?'translate3d('+(dx*.2).toFixed(1)+'px,'+(dy*.3).toFixed(1)+'px,0)':''})},{passive:true});
d.documentElement.addEventListener('mouseleave',()=>{ring.style.opacity=0});
addEventListener('mousedown',()=>ring.classList.add('dn'));addEventListener('mouseup',()=>ring.classList.remove('dn'));
}
})();

</script>
</body>
</html>
